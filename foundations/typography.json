        }
      },
      "l": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.semiBold}",
          "fontSize": "14px",
          "lineHeight": "20px",
          "letterSpacing": "0px"
        }
      },
      "xl": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.semiBold}",
          "fontSize": "16px",
          "lineHeight": "24px",
          "letterSpacing": "0px"
        }
      }
    },

    "dialogue": {
      "speaker": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "14px",
          "lineHeight": "20px",
          "letterSpacing": "0px"
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "16px",
          "lineHeight": "24px",
          "letterSpacing": "0px"
        }
      }
    }
  }
}
