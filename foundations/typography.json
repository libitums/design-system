{
  "$schema": "https://tr.designtokens.org/format/",
  "font": {
    "family": {
      "$type": "fontFamily",
      "default": { "$value": "Futura" }
    },
    "weight": {
      "$type": "fontWeight",
      "medium": { "$value": 500 },
      "bold": { "$value": 700 }
    }
  },

  "typography": {
    "$type": "typography",

    "display": {
      "$value": {
        "fontFamily": "{font.family.default}",
        "fontWeight": "{font.weight.bold}",
        "fontSize": "34px",
        "lineHeight": "41px",
        "letterSpacing": "-1.4px"
      }
    },

    "heading": {
      "l": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "28px",
          "lineHeight": "34px",
          "letterSpacing": "-0.8px"
        }
      },
      "m": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "22px",
          "lineHeight": "28px",
          "letterSpacing": "-0.4px"
        }
      },
      "s": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "18px",
          "lineHeight": "24px",
          "letterSpacing": "0px"
        }
      }
    },

    "body": {
      "l": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "16px",
          "lineHeight": "24px",
          "letterSpacing": "0.32px"
        }
      },
      "m": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "14px",
          "lineHeight": "20px",
          "letterSpacing": "0.28px"
        }
      },
      "s": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "12px",
          "lineHeight": "16px",
          "letterSpacing": "0.24px"
        }
      }
    },

    "caption": {
      "$value": {
        "fontFamily": "{font.family.default}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "11px",
        "lineHeight": "14px",
        "letterSpacing": "0.44px"
      }
    },

    "label": {
      "xl": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "16px",
          "lineHeight": "24px",
          "letterSpacing": "0.32px"
        }
      },
      "l": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "14px",
          "lineHeight": "20px",
          "letterSpacing": "0.28px"
        }
      },
      "m": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "12px",
          "lineHeight": "16px",
          "letterSpacing": "0.24px"
        }
      },
      "s": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "10px",
          "lineHeight": "14px",
          "letterSpacing": "1.2px"
        }
      }
    }
  }
}
