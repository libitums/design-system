{
  "$schema": "https://tr.designtokens.org/format/",
  "font": {
    "family": {
      "$type": "fontFamily",
      "default": { "$value": "Pretendard Variable" },
      "accent": { "$value": "Futura" }
    },
    "weight": {
      "$type": "fontWeight",
      "medium": { "$value": 500 },
      "bold": { "$value": 700 },
      "extraBold": { "$value": 800 }
    }
  },

  "typography": {
    "$type": "typography",

    "accent": {
      "display": {
        "$value": {
          "fontFamily": "{font.family.accent}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "34px",
          "lineHeight": "41px",
          "letterSpacing": "-1.4px"
        }
      },
      "chapter": {
        "$value": {
          "fontFamily": "{font.family.accent}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "24px",
          "lineHeight": "30px",
          "letterSpacing": "-0.8px"
        }
      },
      "metric": {
        "$value": {
          "fontFamily": "{font.family.accent}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "16px",
          "lineHeight": "20px",
          "letterSpacing": "0.32px"
        }
      },
      "reward": {
        "$value": {
          "fontFamily": "{font.family.accent}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "14px",
          "lineHeight": "20px",
          "letterSpacing": "0.28px"
        }
      }
    },

    "display": {
      "$value": {
        "fontFamily": "{font.family.default}",
        "fontWeight": "{font.weight.extraBold}",
        "fontSize": "34px",
        "lineHeight": "41px",
        "letterSpacing": "-1.4px"
      }
    },

    "heading": {
      "l": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "28px",
          "lineHeight": "34px",
          "letterSpacing": "-0.8px"
        }
      },
      "m": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "22px",
          "lineHeight": "28px",
          "letterSpacing": "-0.4px"
        }
      },
      "s": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "18px",
          "lineHeight": "24px",
          "letterSpacing": "0px"
        }
      }
    },

    "body": {
      "l": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "16px",
          "lineHeight": "24px",
          "letterSpacing": "0px"
        }
      },
      "m": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "14px",
          "lineHeight": "20px",
          "letterSpacing": "0px"
        }
      },
      "s": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "12px",
          "lineHeight": "18px",
          "letterSpacing": "0px"
        }
      }
    },

    "caption": {
      "$value": {
        "fontFamily": "{font.family.default}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "11px",
        "lineHeight": "16px",
        "letterSpacing": "0.2px"
      }
    },

    "label": {
      "xl": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "16px",
          "lineHeight": "24px",
          "letterSpacing": "0px"
        }
      },
      "l": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "14px",
          "lineHeight": "20px",
          "letterSpacing": "0px"
        }
      },
      "m": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "12px",
          "lineHeight": "16px",
          "letterSpacing": "0.12px"
        }
      },
      "s": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "10px",
          "lineHeight": "14px",
          "letterSpacing": "0.8px"
        }
      }
    },

    "button": {
      "$value": {
        "fontFamily": "{font.family.default}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "14px",
        "lineHeight": "20px",
        "letterSpacing": "0px"
      }
    },

    "dialogue": {
      "speaker": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "14px",
          "lineHeight": "20px",
          "letterSpacing": "0px"
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "16px",
          "lineHeight": "24px",
          "letterSpacing": "0px"
        }
      }
    }
  }
}
