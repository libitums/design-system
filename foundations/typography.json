          "lineHeight": "20px",
          "letterSpacing": "0px"
        }
      },
      "m": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "12px",
          "lineHeight": "16px",
          "letterSpacing": "0.12px"
        }
      },
      "s": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "10px",
          "lineHeight": "14px",
          "letterSpacing": "0.8px"
        }
      }
    },

    "button": {
      "s": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.semiBold}",
          "fontSize": "12px",
          "lineHeight": "16px",
          "letterSpacing": "0.12px"
        }
      },
      "m": {
