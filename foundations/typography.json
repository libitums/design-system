{
  "$schema": "https://tr.designtokens.org/format/",
  "font": {
    "family": {
      "$type": "fontFamily",
      "default": {
        "$description": "Web은 Pretendard Variable부터 CSS fallback 순서로 사용하고, 앱 adapter는 등록된 Pretendard Variable 또는 플랫폼 기본 UI 폰트로 연결하는 Default family",
        "$value": [
          "Pretendard Variable",
          "Pretendard",
          "-apple-system",
          "BlinkMacSystemFont",
          "system-ui",
          "Roboto",
          "Helvetica Neue",
          "Segoe UI",
          "Apple SD Gothic Neo",
          "Noto Sans KR",
          "Malgun Gothic",
          "Apple Color Emoji",
          "Segoe UI Emoji",
          "Segoe UI Symbol",
          "sans-serif"
        ]
      },
      "accent": {
        "$description": "Web은 설치된 Futura를 우선하고, 앱은 App 라이선스로 등록된 Futura만 사용하며, 그 외에는 Default로 이어지는 Accent family",
        "$value": [
          "Futura",
          "Pretendard Variable",
          "Pretendard",
          "-apple-system",
          "BlinkMacSystemFont",
          "system-ui",
          "Roboto",
          "Helvetica Neue",
          "Segoe UI",
          "Apple SD Gothic Neo",
          "Noto Sans KR",
          "Malgun Gothic",
          "Apple Color Emoji",
          "Segoe UI Emoji",
          "Segoe UI Symbol",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "medium": { "$value": 500 },
      "semiBold": { "$value": 600 },
      "bold": { "$value": 700 },
      "extraBold": { "$value": 800 }
    }
  },

  "typography": {
    "$type": "typography",

    "accent": {
      "display": {
        "$value": {
          "fontFamily": "{font.family.accent}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "34px",
          "lineHeight": "41px",
          "letterSpacing": "-1.4px"
        }
      },
      "chapter": {
        "$value": {
          "fontFamily": "{font.family.accent}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "24px",
          "lineHeight": "30px",
          "letterSpacing": "-0.8px"
        }
      },
      "metric": {
        "$value": {
          "fontFamily": "{font.family.accent}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "16px",
          "lineHeight": "20px",
          "letterSpacing": "0.32px"
        }
      },
      "reward": {
        "$value": {
          "fontFamily": "{font.family.accent}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "14px",
          "lineHeight": "20px",
          "letterSpacing": "0.28px"
        }
      }
    },

    "display": {
      "$value": {
        "fontFamily": "{font.family.default}",
        "fontWeight": "{font.weight.extraBold}",
        "fontSize": "34px",
        "lineHeight": "41px",
        "letterSpacing": "-1.4px"
      }
    },

    "heading": {
      "l": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "28px",
          "lineHeight": "34px",
          "letterSpacing": "-0.8px"
        }
      },
      "m": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "22px",
          "lineHeight": "28px",
          "letterSpacing": "-0.4px"
        }
      },
      "s": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "18px",
          "lineHeight": "24px",
          "letterSpacing": "0px"
        }
      }
    },

    "body": {
      "l": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "16px",
          "lineHeight": "24px",
          "letterSpacing": "0px"
        }
      },
      "m": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "14px",
          "lineHeight": "20px",
          "letterSpacing": "0px"
        }
      },
      "s": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.medium}",
          "fontSize": "12px",
          "lineHeight": "18px",
          "letterSpacing": "0px"
        }
      }
    },

    "caption": {
      "$value": {
        "fontFamily": "{font.family.default}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "11px",
        "lineHeight": "16px",
        "letterSpacing": "0.2px"
      }
