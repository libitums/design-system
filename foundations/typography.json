    "label": {
      "xl": {
        "$value": {
          "fontFamily": "{font.family.default}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "16px",
          "lineHeight": "24px",
          "letterSpacing": "0px"
        }
      },
      "l": {
