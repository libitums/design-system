{
  "$schema": "https://tr.designtokens.org/format/",
  "color": {
    "gray": {
      "$type": "color",
      "950": { "$value": "#1A1C20" },
      "900": { "$value": "#2A3038" },
      "800": { "$value": "#555D6D" },
      "700": { "$value": "#868B94" },
      "600": { "$value": "#B0B3BA" },
      "500": { "$value": "#D1D3D8" },
      "400": { "$value": "#DCDEE3" },
      "300": { "$value": "#EEEFF1" },
      "200": { "$value": "#F3F4F5" },
      "100": { "$value": "#F7F8F9" },
      "50": { "$value": "#F9F9FA" }
    },
    "white": { "$type": "color", "$value": "#FFFFFF" },

    "fg": {
      "$type": "color",
      "neutral": {
        "$description": "제목과 핵심 정보에 사용하는 기본 전경색",
        "$value": "{color.gray.950}"
      },
      "neutral-muted": {
        "$description": "기본보다 낮고 subtle보다 높은 강조의 전경색",
        "$value": "{color.gray.800}"
      },
      "neutral-subtle": {
        "$description": "아이콘, 라벨, 캡션에 사용하는 보조 전경색",
        "$value": "{color.gray.700}"
      },
      "neutral-subtlest": {
        "$description": "설명과 부가 정보에 사용하는 가장 낮은 강조의 전경색",
        "$value": "{color.gray.600}"
      },
      "neutral-inverted": {
        "$description": "강한 색상의 표면 위에 사용하는 반전 전경색",
        "$value": "{color.white}"
      },
      "disabled": {
        "$description": "공통 비활성 텍스트와 아이콘에 사용하는 전경색",
        "$value": "{color.gray.400}"
      },
      "brand": {
        "$description": "브랜드 강조 텍스트와 아이콘에 사용하는 전경색",
        "$value": "{color.brand.primary}"
      }
    },

    "brand": {
      "$type": "color",
      "primary": { "$value": "#F46B18" },
      "primary-pressed": { "$value": "#B94208" },
      "secondary": { "$value": "#FF8D28" },
      "reward-border": { "$value": "#C94B09" },
      "reward-disabled-surface": { "$value": "#FFF0E6" },
      "reward-disabled-text": { "$value": "#D89A70" }
    },

    "feedback": {
      "$type": "color",
      "correct": { "$value": "#35A66F" },
      "correct-surface": { "$value": "#EDFFF3" },
      "correct-text": { "$value": "#206541" },
      "incorrect": { "$value": "#DF4D54" },
      "incorrect-surface": { "$value": "#FFF0F1" },
      "incorrect-text": { "$value": "#A62E34" },
      "warning": { "$value": "#FFC500" },
      "warning-surface": { "$value": "#FFF4D6" },
      "warning-text": { "$value": "#9A6800" }
    },

    "background": {
      "$type": "color",
      "primary": { "$value": "#FFFDFC" },
      "secondary": { "$value": "#FAF7F4" },
      "elevated": { "$value": "#FFF3EA" }
    },

    "border": {
      "$type": "color",
      "default": { "$value": "#848184" },
      "strong": { "$value": "#141115" },
      "disabled": { "$value": "#B7B4B8" }
    }
  }
}
